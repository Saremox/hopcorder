<!--
Merged into the image's config.xml (config.d). user_files_path and
format_schema_path point at an empty directory the clickhouse user cannot
write. ClickHouse 25.8's sqlite() table function creates its database file
under user_files before it checks the caller's grant, so Grafana's
read-only user, refused every time, still left one empty file per query,
never removed, until the data volume ran out of inodes and ingest failed
(review round six). A CapnProto or Protobuf output without a schema
(formatRow('CapnProto', 1), FORMAT ProtobufList) writes a generated schema
to a temporary file under format_schemas, and one that fails to generate
leaves it there: the same, about 1,000 files a second (review round seven;
the read-only user's profile also turns that generation off). No hopcorder
query uses either directory. CLICKHOUSE_DO_NOT_CHOWN (docker-compose.yml)
keeps the image's entrypoint from handing /srv to the clickhouse user.

ClickHouse's own logs are kept 7 days (as in the chart) on a disk of their
own on the data volume that keeps a quarter of the file system free: one
failing query of Grafana's read-only user wrote its exception message, up
to the user's memory limit, into query_log and three times into text_log
(about 200 MB here), with no TTL, so a few dozen filled the disk (review
round seven). Log writes now stop, and are dropped, while less than 25% of
the file system is free; hopcorder's data may use the rest. Every log the
image turns on is there: a refused BACKUP still wrote its whole destination
into backup_log (review round seven, again). opentelemetry_span_log, which
kept a traced query's exception three times and cannot take a storage
policy (the image gives it an engine), is off; hopcorder does not trace.
-->
<clickhouse>
    <user_files_path>/srv/</user_files_path>
    <format_schema_path>/srv/</format_schema_path>
    <storage_configuration>
        <disks>
            <system_logs>
                <path>/var/lib/clickhouse/system_logs/</path>
                <keep_free_space_ratio>0.25</keep_free_space_ratio>
            </system_logs>
        </disks>
        <policies>
            <system_logs><volumes><main><disk>system_logs</disk></main></volumes></system_logs>
        </policies>
    </storage_configuration>
    <query_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_log>
    <query_thread_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_thread_log>
    <query_views_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_views_log>
    <query_metric_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_metric_log>
    <part_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>
    <trace_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></trace_log>
    <metric_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></asynchronous_metric_log>
    <error_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></error_log>
    <text_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></text_log>
    <processors_profile_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></processors_profile_log>
    <backup_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></backup_log>
    <asynchronous_insert_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></asynchronous_insert_log>
    <blob_storage_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></blob_storage_log>
    <crash_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></crash_log>
    <iceberg_metadata_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></iceberg_metadata_log>
    <s3queue_log><storage_policy>system_logs</storage_policy><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></s3queue_log>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
