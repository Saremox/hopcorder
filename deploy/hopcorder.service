# systemd unit for the hopcorder agent.
#
#   install -m 0755 hopcorder /usr/local/bin/hopcorder
#   install -D -m 0644 deploy/agent.example.yaml /etc/hopcorder/agent.yaml
#   install -m 0644 deploy/hopcorder.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now hopcorder
#
# The agent runs as an unprivileged dynamic user. Its only capability is
# CAP_NET_RAW (raw ICMP/UDP sockets), granted as an ambient capability, so the
# binary needs no setcap. The spool lives in StateDirectory (/var/lib/hopcorder)
# and a JSONL file, if configured, in LogsDirectory (/var/log/hopcorder).

[Unit]
Description=hopcorder network path recorder (agent)
Documentation=https://github.com/Saremox/hopcorder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hopcorder agent --config /etc/hopcorder/agent.yaml
# Re-read the config (an invalid one is rejected and the running one kept)
# and reopen the JSONL file, e.g. after log rotation.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
# SIGTERM: stop probing, give outputs a few seconds, exit. Spooled records
# survive; this only bounds how long systemd waits.
TimeoutStopSec=15s

DynamicUser=yes
StateDirectory=hopcorder
LogsDirectory=hopcorder
ConfigurationDirectory=hopcorder
# Secrets (an ingest token or password, a client certificate's key): the
# dynamic user can only read world-readable files, agent.yaml included, so
# keep them out of it. Keep each in a root-only file (e.g. in a 0700
# /etc/hopcorder/secrets), pass it as a credential and point the config at
# /run/credentials/hopcorder.service/<name>:
#   bearer_token_file: /run/credentials/hopcorder.service/token
#   basic_auth: {username: ..., password_file: /run/credentials/hopcorder.service/password}
#   tls: {cert_file: ..., key_file: /run/credentials/hopcorder.service/client.key}
# systemd reads credentials when the unit starts: restart it after a change.
#LoadCredential=token:/etc/hopcorder/secrets/token
#LoadCredential=password:/etc/hopcorder/secrets/password
#LoadCredential=client.key:/etc/hopcorder/secrets/client.key

AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes

# Hardening. Raw sockets need AF_INET/AF_INET6; AF_NETLINK is used by the Go
# resolver and route lookups, AF_UNIX by the system resolver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
